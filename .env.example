# Copie para deploy/.env e preencha. NUNCA versione o arquivo .env real.
CIO_ENV=production
CIO_DOMAIN=relatorios.europcar.com.br
CIO_BASE_URL=https://relatorios.europcar.com.br
CIO_SECRET_KEY=            # gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
CIO_ALLOWED_DOMAIN=europcar.com.br

# PostgreSQL (produção). Vazio = SQLite local em /data (somente desenvolvimento).
DATABASE_URL=postgresql://cio_app:SENHA@postgres:5432/cio_portal

# Cliente OAuth Zoho de INGESTÃO (Self Client; refresh token gerado com: python -m cio zoho-token --code <código>). Escopos: ZohoMail.accounts.READ, ZohoMail.folders.READ,
# ZohoMail.messages.READ, WorkDrive.files.READ, WorkDrive.files.CREATE, WorkDrive.team.READ, WorkDrive.teamfolders.READ
ZOHO_INGEST_CLIENT_ID=
ZOHO_INGEST_CLIENT_SECRET=
ZOHO_INGEST_REFRESH_TOKEN=
ZOHO_MAIL_ACCOUNT_IDS=3063450000000008002
ZOHO_WORKDRIVE_ROOT_FOLDER_ID=wm4c6d2b17b41899e4746afe91dc51f8c301c   # My Folders/CIO - Relatorios (privada)

# Cliente OAuth Zoho de LOGIN (Server-based). Escopos: openid email profile
# Redirect URI: https://relatorios.europcar.com.br/auth/callback
ZOHO_LOGIN_CLIENT_ID=
ZOHO_LOGIN_CLIENT_SECRET=

INGEST_ENABLED=false                # ativar só após aprovação (Etapa 4)
INGEST_INTERVAL_MIN=10
INGEST_SENDERS=callcenter@europcar.com.br,luis.miguel@europcar.com.br
INGEST_SUBJECT_PREFIX=🔵
MAX_ATTACHMENT_MB=25
SESSION_IDLE_HOURS=8
SESSION_MAX_DAYS=7
RETENTION_MONTHS=24
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
BACKUP_DIR=/backups                # volume separado de /data
RESTORE_TEST_DATABASE_URL=          # opcional: banco vazio cio_restore_test (teste real de restauração)
BACKUP_TO_WORKDRIVE=false           # opcional: cópia dos backups na pasta privada do WorkDrive
REQUIRE_DMARC=true
